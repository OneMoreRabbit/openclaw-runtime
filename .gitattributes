# Always normalise text files; default text-detection with LF in the repo.
* text=auto eol=lf

# Files that MUST be LF regardless of platform — Docker, bash, and config
# files inside the image will misbehave if these get CRLF line endings.
*.sh        text eol=lf
*.env       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.j2        text eol=lf
Dockerfile  text eol=lf
.dockerignore text eol=lf
.gitignore  text eol=lf
# --- Atlas --- scripts and conf must stay LF everywhere: CRLF breaks the
# shebang in Linux containers and puts \r into sourced values, which fails
# the write guard open. Targeted rules only — repo-wide eol policy is yours.
*.sh text eol=lf
.atlas.conf text eol=lf
